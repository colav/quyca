# Copy to .env.dev (develop branch) or .env.prod (main branch) and fill in the values.
# The file is picked by the ENVIRONMENT variable (dev | prod), already set by each Docker target.
# Variables marked (optional) can be omitted; their default is shown.

# --- App ---
APP_NAME=quyca
APP_VERSION=0.1.0
APP_PORT=8080
APP_DOMAIN=http://localhost:8080
# True enables gunicorn auto-reload (dev only)
APP_DEBUG=False

# (optional) prefix for every route, e.g. /api
API_URL_PREFIX=
# (optional) JSON list of allowed origins; regex allowed
# CORS_ORIGINS=["http://localhost:3000", "https?://(.*\\.)?impactu\\.colav\\.co$"]

# --- MongoDB ---
MONGO_SERVER=localhost
MONGO_PORT=27017
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_DATABASE=kahi
MONGO_CALCULATIONS_DATABASE=kahi_calculations
MONGO_IMPACTU_DATABASE=impactu

# --- Elasticsearch ---
ES_SERVER=http://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=changeme
ES_PERSON_COMPLETER_INDEX=kahi_person
ES_INSTITUTION_COMPLETER_INDEX=kahi_institution
ES_GROUP_COMPLETER_INDEX=kahi_group
ES_DEPARTMENT_COMPLETER_INDEX=kahi_department
ES_FACULTY_COMPLETER_INDEX=kahi_faculty
ES_SOURCES_COMPLETER_INDEX=kahi_sources

# --- Auth (flask-jwt-extended) ---
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_EXPIRES=3600
# (optional) cookie domain; leave empty for localhost
# JWT_COOKIE_DOMAIN=.impactu.colav.co

# --- Files and Google ---
# Folder used when Google Drive upload fails
LOCAL_STORAGE_PATH=/app/reports
# Path to the Google OAuth token .pickle
GOOGLE_CREDENTIALS=/app/token.pickle
# Google Drive parent folder ID
GOOGLE_PARENT_ID=

# --- Sentry --- (empty DSN disables it)
SENTRY_DSN=
# (optional) 0.0 - 1.0
# SENTRY_TRACES_SAMPLE_RATE=1.0
# SENTRY_PROFILES_SAMPLE_RATE=1.0

# --- Gunicorn --- (optional)
# GUNICORN_WORKERS=12
# GUNICORN_TIMEOUT=600
